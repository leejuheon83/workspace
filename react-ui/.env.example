# Supabase — 대시보드 프로젝트 이름: sbsmcworkspace
# Project Settings → API 에서 anon public key 복사 (URL은 아래 고정)
VITE_SUPABASE_URL=https://piaopscawhtxrkxogdpw.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# (선택) 사번 뒤에 붙는 도메인. 비우면 코드 기본값 sbsmc.workspace 사용.
# Supabase 사용자 이메일은 반드시 {사번}@도메인 과 일치해야 함.
VITE_LOGIN_EMAIL_DOMAIN=

# Node 전용: npm run auth:sync-credentials (서비스 롤은 브라우저에 노출되지 않음)
# SUPABASE_SERVICE_ROLE_KEY=

# 관리자 사번(콤마 구분). 비우면 120032 만 회사 고정 메뉴 추가 가능
# VITE_ADMIN_EMPLOYEE_IDS=120032
